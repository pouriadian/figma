# COPY to .env before running docker compose.
# Replace ALL secret values. Set DJANGO_DEBUG=0 behind a real HTTPS reverse proxy.
POSTGRES_DB=faromid
POSTGRES_USER=faromid
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_50_CHAR_RANDOM_SECRET
API_PROXY_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000
DJANGO_CORS_ORIGINS=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3000
BOOTSTRAP_MIGRATIONS=1
SEED_INITIAL_DATA=1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Faromid <no-reply@faromid.com>
SMS_WEBHOOK_URL=
SMS_API_TOKEN=
SMS_MODE=mock
FARAZSMS_API_KEY=
FARAZSMS_BASE_URL=https://api.iranpayamak.com
FARAZSMS_SENDER_LINE=
SMS_BULK_BATCH_SIZE=50
DJANGO_ENABLE_HSTS=0
